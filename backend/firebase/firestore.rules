rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isLandlord() {
      return hasRole('landlord');
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Students ───────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isSignedIn() && (isOwner(studentId) || isAdmin());
      allow write: if isSignedIn() && (isOwner(studentId) || isAdmin());
    }

    // ── Landlords ──────────────────────────────────────────────────────────────
    match /landlords/{landlordId} {
      allow read: if isSignedIn() && (isOwner(landlordId) || isAdmin());
      allow write: if isSignedIn() && (isOwner(landlordId) || isAdmin());
    }

    // ── Properties ─────────────────────────────────────────────────────────────
    match /properties/{propertyId} {
      allow read: if isSignedIn();
      allow create: if isLandlord() || isAdmin();
      allow update, delete: if isAdmin() ||
        (isLandlord() && resource.data.landlordId == request.auth.uid);
    }

    // ── Bookings ───────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid
      );
      allow create: if isStudent();
      allow update: if isAdmin() ||
        resource.data.landlordId == request.auth.uid ||
        (resource.data.studentId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    // ── Reviews ────────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isStudent();
      allow update, delete: if isAdmin() ||
        resource.data.authorId == request.auth.uid;
    }

    // ── Notifications ──────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow delete: if isAdmin() ||
        resource.data.userId == request.auth.uid;
    }

    // ── Chats ──────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.studentId &&
        request.resource.data.studentId is string &&
        request.resource.data.landlordId is string &&
        request.resource.data.propertyId is string &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid
      );
      allow delete: if false;

      // ── Messages subcollection ───────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.studentId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.landlordId == request.auth.uid
        );
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

  }
}